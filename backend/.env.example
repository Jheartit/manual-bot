# Google Drive
# 로컬 개발: 서비스 계정 JSON 파일 경로
# 배포(Railway 등 파일 업로드가 번거로운 PaaS): service_account.json 파일 내용을 그대로 붙여넣기
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
# 청약/배서 매뉴얼 통합 루트 폴더 ID (그 아래에 "청약", "배서" 하위 폴더가 있어야 함)
DRIVE_ROOT_FOLDER_ID=여기에_통합루트_폴더ID
# (선택) 담당자별로 폴더가 여러 개 있을 때, 폴더명에 이 문자열이 포함된 것만 사용
DRIVE_OWNER_TAG=

# DB (pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/manualbot

# Embedding
VOYAGE_API_KEY=여기에_voyage_api_key

# GPT (답변 생성 + OCR)
OPENAI_API_KEY=여기에_openai_api_key
